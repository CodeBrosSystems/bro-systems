---
const COMMUNITY_HIGHLIGHTS = [
  { number: "50+", label: "Miembros activos", icon: "users", color: "blue" },
  { number: "12", label: "Proyectos en curso", icon: "code", color: "green" },
  { number: "6", label: "Áreas de conocimiento", icon: "layers", color: "purple" },
  { number: "∞", label: "Ganas de aprender", icon: "heart", color: "pink" },
];
---

<section id="comunidad-stats" class="section bg-gradient-to-b from-slate-900 to-slate-800">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-16" data-animate>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        Nuestra <span class="text-primary-400">comunidad</span> en cifras
      </h2>
      <p class="text-lg text-slate-300">
        Bro Systems es más que un grupo: es un espacio donde developers, diseñadores y entusiastas de la tecnología crecen juntos.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {COMMUNITY_HIGHLIGHTS.map((item, index) => (
        <div class="text-center p-6" data-animate style="animation-delay: ${index * 150}ms">
          <div class={`
            text-5xl md:text-6xl font-extrabold mb-2
            ${item.color === "blue" ? "text-blue-400" : ""}
            ${item.color === "green" ? "text-green-400" : ""}
            ${item.color === "purple" ? "text-purple-400" : ""}
            ${item.color === "pink" ? "text-pink-400" : ""}
          `}>
            {item.number}
          </div>
          <p class="text-slate-400 text-lg">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section> 