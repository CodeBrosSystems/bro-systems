---
const FOUNDERS = [
  {
    name: "Ignacio Pérez",
    role: "Desarrollador Junior & Co-Fundador",
    bio: "Ignacio Pérez, de 22 años, es un Desarrollador Junior y estudiante de último año de Ingeniería en Informática en la institución Santo Tomás. Ha trabajado con tecnologías como Vue.js, Hasura y GraphQL, participando en el desarrollo de aplicaciones web modernas.",
    image: "/images/founders/IgnacioPerez.jpg",
    social: {
      instagram: "https://instagram.com/nachoofc",
      linkedin: "https://linkedin.com/in/ignacioprerez",
      github: "https://github.com/NachoOFC",
      portfolio: "https://nachoportafolio.me/",
      repositorio: "https://github.com/NachoOFC",
    },
    portfolio: "https://nachoportafolio.me/",
    repositorio: "https://github.com/NachoOFC/bro-systems",
  }
];

// Miembros pendientes de agregar foto/info
const PENDING_MEMBERS = [
  { name: "George", placeholder: true },
  { name: "Francisco", placeholder: true },
  { name: "Rodrigo", placeholder: true },
];

type SocialType = "instagram" | "linkedin" | "github";
---

<section id="fundadores" class="section py-16 md:py-24">
  <div class="container px-4 mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16" data-animate>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4">
        <span class="text-sky-400">Conoce a nuestros </span><span class="text-primary-600 dark:text-primary-400"
          >fundadores</span
        >
      </h2>
      <p class="text-lg text-white mb-6">
        Detrás de Bro Systems hay personas con pasión por la tecnología y el
        código abierto. Conoce a quienes hacen esto posible.
      </p>
    </div>

    <!-- Fundador principal -->
    <div class="flex justify-center mb-12 md:mb-16">
      {
        FOUNDERS.map((founder, index) => (
          <div
            class="flex flex-col sm:flex-row gap-6 items-center sm:items-start bg-white dark:bg-slate-800 p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow max-w-2xl"
            data-animate="fade-up"
          >
            <div class="w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-xl overflow-hidden flex-shrink-0 bg-white p-1 shadow-md">
              <img
                src={founder.image}
                alt={founder.name}
                class="w-full h-full object-cover rounded-lg"
              />
            </div>

            <div class="text-center sm:text-left">
              <h3 class="text-xl sm:text-2xl font-bold mb-1">{founder.name}</h3>
              <p class="text-primary-600 dark:text-primary-400 font-medium mb-3 md:mb-4">
                {founder.role}
              </p>
              <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mb-4 md:mb-6">
                {founder.bio}
              </p>

              <div class="flex flex-wrap justify-center sm:justify-start gap-3">
                <a
                  href={founder.social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors"
                  aria-label={`GitHub de ${founder.name}`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                </a>
                <a
                  href={founder.social.portfolio}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-cyan-400 transition-colors text-sm font-medium"
                  aria-label={`Portafolio de ${founder.name}`}
                >
                  <div class="flex items-center gap-1 bg-slate-700/50 px-3 py-1 rounded-full hover:bg-slate-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    </svg>
                    Portafolio
                  </div>
                </a>
                <a
                  href={founder.repositorio}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-green-400 transition-colors text-sm font-medium"
                  aria-label={`Repositorio de ${founder.name}`}
                >
                  <div class="flex items-center gap-1 bg-slate-700/50 px-3 py-1 rounded-full hover:bg-slate-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                    Repositorio
                  </div>
                </a>
                <a
                  href={founder.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-[#0077B5] transition-colors"
                  aria-label={`LinkedIn de ${founder.name}`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Miembros pendientes - Cuadros vacíos -->
    <div class="text-center mb-8">
      <h3 class="text-xl font-semibold text-slate-300 mb-2">Próximamente</h3>
      <p class="text-slate-400 text-sm">Nuevos miembros del equipo</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
      {
        PENDING_MEMBERS.map((member) => (
          <div
            class="flex flex-col items-center bg-slate-800/50 border-2 border-dashed border-slate-600 p-6 rounded-xl hover:border-primary-500/50 transition-colors"
            data-animate="fade-up"
          >
            <div class="w-24 h-24 rounded-full bg-slate-700 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h4 class="text-lg font-semibold text-slate-300">{member.name}</h4>
            <p class="text-sm text-slate-500">Próximamente</p>
          </div>
        ))
      }
    </div>
    <!-- Fin de la sección de fundadores -->
  </div>
</section>
