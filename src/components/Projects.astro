---
const PROJECTS = [
  {
    title: "Web Bro Systems",
    image: "/images/Proyectos/analitico.jpg",
    description: "Nuestra propia landing page comunitaria construida con Astro y TailwindCSS. Open source y colaborativa.",
    tags: ["Astro", "TailwindCSS", "TypeScript"]
  },
  {
    title: "API de la Comunidad",
    image: "/images/Proyectos/ecomerce.jpg",
    description: "Backend open source para gestionar miembros, proyectos y eventos de la comunidad Bro Systems.",
    tags: ["Node.js", "Fastify", "MongoDB"]
  },
  {
    title: "App Bro Community",
    image: "/images/Proyectos/App.jpg",
    description: "App móvil para conectar miembros, compartir logros y coordinar meetups locales.",
    tags: ["React Native", "Firebase", "TypeScript"]
  },
  {
    title: "CLI Tools",
    image: "/images/Proyectos/crm.jpg",
    description: "Colección de herramientas de línea de comandos creadas por y para la comunidad. Contribuciones bienvenidas.",
    tags: ["Rust", "Go", "Python"]
  }
];
---

<section id="proyectos" class="section">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-16" data-animate>
      <h2 class="text-primary-600 md:text-4xl font-bold mb-4">
        Proyectos de la <span class="text-primary-600 dark:text-primary-400">comunidad</span>
      </h2>
      <p class="text-lg text-slate-700 text-white">
        Estos son algunos de los proyectos en los que colaboramos como comunidad. Todos son open source y aceptan contribuciones.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {PROJECTS.map((project, index) => (
        <div 
          class="group bg-white dark:bg-slate-800 overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-all border border-slate-100 dark:border-slate-700"
          data-animate={index % 2 === 0 ? "fade-right" : "fade-left"}
        >
          <div class="relative overflow-hidden aspect-[16/9]">
            <img
              src={project.image}
              
              alt={project.title}
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">{project.title}</h3>
            <p class="text-slate-600 dark:text-slate-400 mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <span class="px-3 py-1 text-xs font-medium bg-slate-100 dark:bg-slate-700 text-slate-800 dark:text-slate-200 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center" data-animate>
      <a href="https://github.com/NachoOFC/bro-systems" target="_blank" class="btn btn-primary">
        Contribuir en GitHub →
      </a>
    </div>
  </div>
</section> 